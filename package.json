{
  "name": "claude-telegram-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.18.0 <23" },
  "scripts": {
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "node --env-file=.env --import tsx src/main.ts",
    "check": "node --env-file=.env --import tsx src/main.ts --check"
  },
  "dependencies": { "@anthropic-ai/claude-agent-sdk": "0.3.314" },
  "devDependencies": { "@types/node": "^22.0.0", "tsx": "4.23.15", "typescript": "7.0.2" }
}
