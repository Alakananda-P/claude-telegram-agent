# Copy to .env locally; never commit real credentials.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
ANTHROPIC_API_KEY=
# Optional: dedicated ElevenLabs Scribe v2 transcription (kept outside Claude subprocess).
ELEVENLABS_API_KEY=
# Optional private JSON array; auth/billing/server failures can switch keys before actions.
ANTHROPIC_BACKUP_KEYS=[]
# Optional JSON array of unique non-secret labels, primary first, one per unique key.
# ANTHROPIC_KEY_LABELS=["Primary","Backup 1"]
# Generate 32 random bytes as 64 hex characters; keep privately for backup restores.
BACKUP_ENCRYPTION_KEY=
DATA_DIR=./data
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=high
CLAUDE_FAST_MODE=true
CLAUDE_PERMISSION_MODE=auto
MAX_TURNS=50
JOB_TIMEOUT_MINUTES=20
